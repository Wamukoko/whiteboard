// WhiteBoard — MVP Prisma schema
// Tenancy rules, deletion semantics, and rationale: see /data-model.md
// ADR-003 (Prisma as single source of truth) and ADR-006 (FamilyAccount /
// Institution as tenancy roots) apply to every table below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PLATFORM_ADMIN
  PARENT_GUARDIAN
  LEARNER
  EDUCATOR
  INSTITUTION_ADMIN
  SCHOLARSHIP_PROVIDER
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum CurriculumFamily {
  CBC
  CAMBRIDGE
}

enum ConsentKind {
  AI_PROCESSING
  SCHOLARSHIP_APPLICATION_FOR_MINOR
  DATA_SHARING
}

enum ReviewState {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Phase 2 pipeline state. A background job owns the transition from PENDING to
// READY/FAILED, so the parent review screen can distinguish "still generating"
// from "ready to review" and from "generation failed".
enum ExtractionState {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum GenerationState {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum GeneratedContentType {
  QUIZ
  STUDY_GUIDE
  WORKSHEET
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  DECLINED
  AWARDED
}

enum OpportunityType {
  SCHOLARSHIP
  COMPETITION
  EVENT
}

enum SessionProvider {
  JITSI
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum InstitutionMembershipRole {
  ADMIN
  EDUCATOR
  LEARNER
  STAFF
}

enum LearnerStatus {
  ACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Platform identity (global scope)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  name            String
  imageUrl        String?
  passwordHash    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles                UserRole[]
  familyMemberships    FamilyMembership[]
  educatorProfile      EducatorProfile?
  institutionRoles     InstitutionMembership[]
  uploadedMaterials    UploadedMaterial[]
  consentsGiven        ConsentRecord[]     @relation("ConsentGiver")
  reviewedContent      GeneratedLearningContent[] @relation("ReviewedContent")
  applicationsReviewed Application[]       @relation("ApplicationReviewedBy")
  sessionsTaught       ScheduledSession[]  @relation("InstructorSessions")
  publishedOpportunities Opportunity[]     @relation("OpportunityProvider")
  notifications        Notification[]
  auditActions         AuditLog[]

  @@index([email])
}

model UserRole {
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

// ---------------------------------------------------------------------------
// Family tenancy (ADR-006 root for home learners)
// ---------------------------------------------------------------------------

model FamilyAccount {
  id          String   @id @default(cuid())
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      FamilyMembership[]
  learners     LearnerProfile[]
  uploads      UploadedMaterial[]
  generated    GeneratedLearningContent[] @relation("FamilyGeneratedContent")
  consents     ConsentRecord[]
  subscription Subscription?
  enrollments  Enrollment[]
  sessions     ScheduledSession[]        @relation("FamilySessions")

  @@index([displayName])
}

model FamilyMembership {
  id       String @id @default(cuid())
  familyId String
  userId   String
  isAdmin  Boolean @default(false)

  family FamilyAccount @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model LearnerProfile {
  id          String        @id @default(cuid())
  fullName    String
  initials    String?
  dateOfBirth DateTime
  gender      Gender
  status      LearnerStatus @default(ACTIVE)
  familyId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  family              FamilyAccount        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  enrollments         LearnerCurriculum[]
  progress            LearningProgress[]
  attempts            AssessmentAttempt[]  @relation("LearnerAttempts")
  applications        Application[]        @relation("LearnerApplications")
  sessionEnrollments  SessionEnrollment[]
  generatedContent    GeneratedLearningContent[]

  @@index([familyId])
  @@index([fullName])
}

// Multi-curriculum-per-child is first-class (data-model rule 1): never a
// single curriculum_id column on the learner.
model LearnerCurriculum {
  learnerId    String
  curriculumId String
  gradeBand    String? // CBC band (PP1..G9); null for non-graded streams
  stream       String? // e.g. IGCSE; left open until licensing review
  startedAt    DateTime @default(now())

  learner    LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  curriculum Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@id([learnerId, curriculumId])
  @@index([curriculumId])
}

// ---------------------------------------------------------------------------
// Curriculum hierarchy
// ---------------------------------------------------------------------------

model Curriculum {
  id          String           @id @default(cuid())
  code        String           @unique // "CBC", "CAMBRIDGE"
  family      CurriculumFamily
  name        String
  description String?

  subjects     Subject[]
  enrollments  LearnerCurriculum[]

  @@index([family])
}

model Subject {
  id           String @id @default(cuid())
  curriculumId String
  code         String
  name         String
  sequence     Int    @default(0)

  curriculum  Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  topics      Topic[]
  progress    LearningProgress[]
  assessments Assessment[]     @relation("AssessmentSubject")

  @@unique([curriculumId, code])
  @@index([curriculumId, sequence])
}

model Topic {
  id        String @id @default(cuid())
  subjectId String
  name      String
  sequence  Int    @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([subjectId, sequence])
}

model Lesson {
  id      String @id @default(cuid())
  topicId String
  name    String
  sequence Int    @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, sequence])
}

// ---------------------------------------------------------------------------
// Learning, progress, AI content (family/institution scoped)
// ---------------------------------------------------------------------------

model LearningProgress {
  id            String   @id @default(cuid())
  learnerId     String
  subjectId     String
  masteredUnits Int      @default(0)
  totalUnits    Int      @default(0)
  note          String?
  lastActivityAt DateTime @default(now())

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([learnerId, subjectId])
  @@index([subjectId])
}

model UploadedMaterial {
  id           String   @id @default(cuid())
  familyId     String
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  // Extracted text is the generation input. Kept on the material so a failed
  // generation can be retried without re-uploading or re-running OCR.
  extractionState ExtractionState @default(PENDING)
  extractedText   String?
  extractedChars  Int?
  failureReason   String?
  createdAt       DateTime        @default(now())

  family    FamilyAccount           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy User                   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  generated GeneratedLearningContent[] @relation("SourceMaterialGenerated")

  @@index([familyId, createdAt])
  @@index([extractionState])
}

// AI content origin + review gate (data-model rule 3). Unreviewed content is
// never surfaced to a learner dashboard.
model GeneratedLearningContent {
  id               String                @id @default(cuid())
  familyId         String
  // The learner whose grade band the quiz targets; generation is per learner
  // because difficulty and CBC alignment are grade-band specific.
  learnerId        String
  sourceMaterialId String?
  contentType      GeneratedContentType  @default(QUIZ)
  provider         String // "anthropic"; provider abstraction field
  model            String
  generationState  GenerationState       @default(QUEUED)
  failureReason    String?
  // Token accounting: split for cost analysis, tokensUsed is the total that
  // monthly cap enforcement reads.
  inputTokens      Int                   @default(0)
  outputTokens     Int                   @default(0)
  tokensUsed       Int                   @default(0)
  reviewState      ReviewState           @default(PENDING_REVIEW)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  payload          Json          // structured quiz/content per shared Zod schema
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  family         FamilyAccount             @relation("FamilyGeneratedContent", fields: [familyId], references: [id], onDelete: Cascade)
  learner        LearnerProfile            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  sourceMaterial UploadedMaterial?         @relation("SourceMaterialGenerated", fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  reviewedBy     User?                     @relation("ReviewedContent", fields: [reviewedById], references: [id], onDelete: SetNull)
  assessments    Assessment[]              @relation("ContentAssessment")

  // familyId + createdAt serves monthly cap counting (data-model rule: caps
  // enforced server-side) without a separate ledger table.
  @@index([familyId, createdAt])
  @@index([familyId, reviewState, createdAt])
  @@index([learnerId])
  @@index([generationState])
  @@index([sourceMaterialId])
}

model ConsentRecord {
  id        String      @id @default(cuid())
  familyId  String
  givenById String
  kind      ConsentKind
  granted   Boolean
  grantedAt DateTime    @default(now())

  family FamilyAccount @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User          @relation("ConsentGiver", fields: [givenById], references: [id], onDelete: Restrict)

  @@index([familyId, kind, grantedAt])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

model Assessment {
  id              String    @id @default(cuid())
  title           String
  subjectId       String?
  sourceContentId String?

  subject       Subject?                @relation("AssessmentSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  sourceContent GeneratedLearningContent? @relation("ContentAssessment", fields: [sourceContentId], references: [id], onDelete: SetNull)
  questions     AssessmentQuestion[]
  attempts      AssessmentAttempt[]

  @@index([subjectId])
}

model AssessmentQuestion {
  id            String @id @default(cuid())
  assessmentId  String
  sequence      Int    @default(0)
  prompt        String
  options       Json?
  correctAnswer Json?
  explanation   String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, sequence])
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  assessmentId String
  learnerId    String
  rawAnswers   Json
  score        Float?
  maxScore     Float?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner    LearnerProfile   @relation("LearnerAttempts", fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, assessmentId])
  @@index([learnerId, startedAt])
}

// ---------------------------------------------------------------------------
// Institutions (second tenancy root)
// ---------------------------------------------------------------------------

model Institution {
  id         String  @id @default(cuid())
  name       String
  code       String  @unique
  accredited Boolean @default(false)
  createdAt  DateTime @default(now())

  memberships    InstitutionMembership[]
  educators      EducatorProfile[]
  enrollments    Enrollment[]

  @@index([name])
}

model InstitutionMembership {
  id            String @id @default(cuid())
  institutionId String
  userId        String
  role          InstitutionMembershipRole

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([userId])
}

model EducatorProfile {
  id            String @id @default(cuid())
  userId        String @unique
  institutionId String?
  bio           String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
}

model Enrollment {
  id            String   @id @default(cuid())
  institutionId String
  familyId      String
  cohortCode    String?
  enrolledAt    DateTime @default(now())

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  family      FamilyAccount  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([institutionId, familyId])
}

// ---------------------------------------------------------------------------
// Scholarship & opportunities (data-model: Scholarship / Opportunity)
// ---------------------------------------------------------------------------

model Scholarship {
  id            String @id @default(cuid())
  opportunityId String @unique
  amount        String?
  currency      String?
  donor         String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id                String          @id @default(cuid())
  type              OpportunityType
  title             String
  description       String?
  deadlineAt        DateTime?
  eligibilitySummary String?
  genderEquityFocus Boolean         @default(false)
  verified          Boolean         @default(false)
  providerUserId    String?
  createdAt         DateTime        @default(now())

  provider     User?         @relation("OpportunityProvider", fields: [providerUserId], references: [id], onDelete: SetNull)
  scholarship  Scholarship?
  applications Application[]

  @@index([type, deadlineAt])
  @@index([providerUserId])
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  learnerId     String
  status        ApplicationStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedById  String?
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  opportunity Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  learner     LearnerProfile   @relation("LearnerApplications", fields: [learnerId], references: [id], onDelete: Cascade)
  reviewedBy  User?            @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents   ApplicationDocument[]

  @@unique([opportunityId, learnerId])
  @@index([learnerId])
  @@index([status])
  @@index([opportunityId])
}

model ApplicationDocument {
  id            String @id @default(cuid())
  applicationId String
  kind          String // e.g. "recommendation", "report_card"
  storageKey    String
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Billing, scheduling, notifications
// ---------------------------------------------------------------------------

model Subscription {
  id                 String           @id @default(cuid())
  familyId           String           @unique
  tier               SubscriptionTier @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime         @default(now())
  currentPeriodEndAt DateTime?

  family FamilyAccount @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ScheduledSession {
  id               String          @id @default(cuid())
  title            String
  description      String?
  instructorUserId String?
  familyId         String? // family-scoped live class
  startsAt         DateTime
  endsAt           DateTime
  provider         SessionProvider @default(JITSI)
  meetingUrl       String?
  joinCode         String?
  createdAt        DateTime        @default(now())

  instructor User?              @relation("InstructorSessions", fields: [instructorUserId], references: [id], onDelete: SetNull)
  family     FamilyAccount?     @relation("FamilySessions", fields: [familyId], references: [id], onDelete: SetNull)
  enrollments SessionEnrollment[]

  @@index([startsAt, endsAt])
  @@index([familyId, startsAt])
}

model SessionEnrollment {
  id        String @id @default(cuid())
  sessionId String
  learnerId String
  attended  Boolean @default(false)

  session ScheduledSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner LearnerProfile   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, learnerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// Immutable audit trail (children's-data compliance, data-model rule 6).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  scopeType   String // "family" | "institution" | "system"
  scopeId     String?
  ipHash      String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([scopeType, scopeId, createdAt])
  @@index([actorUserId, createdAt])
}