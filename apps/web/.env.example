# WhiteBoard — web app environment
# Copy to .env.local and adjust. Never commit real secrets.

# PostgreSQL (local Docker compose or Neon/Supabase/RDS)
DATABASE_URL="postgresql://whiteboard:whiteboard@localhost:5432/whiteboard?schema=public"

# Redis (used by BullMQ workers in Phase 2)
REDIS_URL="redis://localhost:6379"

# Auth
# Generate: openssl rand -base64 32 (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# Optional Google OAuth — providers are hidden when these are unset
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Phase 2 — AI quiz generation provider/model (ADR-004).
# The registry of providers/models lives in packages/shared/src/providers.ts.
# Defaults to Anthropic Claude; override to use any OpenAI-compatible server.
AI_PROVIDER="anthropic"          # "anthropic" | "openai-compatible"
AI_MODEL=""                      # blank = the provider's default model
ANTHROPIC_API_KEY=""

# OpenAI-compatible / open-source models (Ollama, vLLM, LM Studio, OpenRouter…).
# Point AI_BASE_URL at the server root; AI_MODEL names the model it serves.
#   Ollama:   AI_BASE_URL="http://localhost:11434/v1"  AI_MODEL="llama3.1:8b"
#   OpenRouter: AI_BASE_URL="https://openrouter.ai/api/v1"
AI_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""

# Model used for PDF/image transcription (OCR). Anthropic-only for now.
# AI_TRANSCRIBE_MODEL="claude-sonnet-5"

# Local-disk object storage root for uploaded materials
STORAGE_ROOT=".whiteboard-storage"